# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
# MongoDB Connection String (SRV format recommended for Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority

# Maximum connections in the Mongoose connection pool per serverless instance.
# Default is 10. For high-concurrency Vercel serverless deployments, keeping this
# at 10 or lower prevents exhausting Atlas connection limits during traffic spikes.
MONGO_MAX_POOL_SIZE=10

# ==============================================================================
# Cache Layer (Upstash Redis)
# ==============================================================================
UPSTASH_REDIS_REST_URL=https://<your-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
CACHE_DEBUG=false

# ==============================================================================
# NextAuth & Site URLs
# ==============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# CORS & Mobile Configuration
# ==============================================================================
# Mobile application origin allowlist (do not use wildcard in production)
MOBILE_ORIGIN=https://labonnadhara.shop
# Additional allowed CORS origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=https://labonnadhara.shop,https://admin.labonnadhara.shop

# ==============================================================================
# Analytics & Monitoring
# ==============================================================================
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ==============================================================================
# Media Storage (Cloudinary)
# ==============================================================================
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_API_KEY=your_cloudinary_api_key_here

# ==============================================================================
# Authentication Providers (Google OAuth)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# Email Delivery (SMTP / Nodemailer)
# ==============================================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@labonnadhara.shop
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM="Labonnadhara <no-reply@labonnadhara.shop>"
ADMIN_EMAIL=admin@labonnadhara.shop

# ==============================================================================
# Telegram Notifications (Order Alerts)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# Invoicing & Integrations
# ==============================================================================
INVOICE_SECRET=your_invoice_secret_key_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=
