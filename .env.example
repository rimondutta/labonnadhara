# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
# MongoDB Connection String (SRV format recommended for Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority

# Maximum connections in the Mongoose connection pool per serverless instance.
# Default is 10. For high-concurrency Vercel serverless deployments, keeping this
# at 10 or lower prevents exhausting Atlas connection limits during traffic spikes.
MONGO_MAX_POOL_SIZE=10

# ==============================================================================
# Cache Layer (Upstash Redis)
# ==============================================================================
UPSTASH_REDIS_REST_URL=https://<your-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ==============================================================================
# NextAuth & Site URLs
# ==============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MOBILE_ORIGIN=*

# ==============================================================================
# Media Storage (Cloudinary)
# ==============================================================================
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_API_KEY=your_cloudinary_api_key_here

